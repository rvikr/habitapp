            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "health.lagan.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1A1A"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND",
        "android.permission.health.READ_SLEEP"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "autoVerify": true,
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "lagan.health",
              "pathPrefix": "/auth/native-confirm"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Lagan — AI Habit Tracker",
      "shortName": "Lagan",
      "description": "Lagan is an AI-enabled habit tracker for iOS, Android, and web. Build routines, get AI coaching and smart reminders, track streaks, and earn XP.",
      "themeColor": "#1A1A1A",
      "backgroundColor": "#f8f9fa",
      "display": "standalone",
      "startUrl": "/app/",
      "lang": "en",
      "scope": "/app/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#F26B1F",
          "defaultChannel": "default",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "./plugins/with-health-connect-rationale",
        {
          "privacyPolicyUrl": "https://lagan.health/privacy"
        }
      ],
      "./plugins/with-lagan-widget",
      "./plugins/with-lagan-android-release",
      "expo-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Lagan reads steps and sleep data from Apple Health to update your habits and home-screen widget.",
          "NSHealthUpdateUsageDescription": "Lagan does not write sleep data today, but HealthKit requires this description for health access setup.",
          "background": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Lagan uses motion data to count steps for your walking habits."
        }
      ],
      [
        "expo-updates",
        {
          "username": "rk12333"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "habbitapp",
          "project": "javascript-react",
          "url": "https://sentry.io/"
        }
      ],
      "expo-localization",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a2e33959-81eb-4c3c-ba61-c2503eb7beba",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "LaganWidgetExtension",
                  "bundleIdentifier": "health.lagan.app.widget",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.health.lagan.app"],
                    "keychain-access-groups": ["$(AppIdentifierPrefix)health.lagan.widget.shared"],
                    "com.apple.developer.healthkit": true
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "rk12333"
  }
}
